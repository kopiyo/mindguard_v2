#!/usr/bin/env sh
set -u

run_gate() {
  local name="$1"
  shift
  echo "→ $name"
  "$@" > logs/pre-commit.log 2>&1
  local rc=$?
  cat logs/pre-commit.log
  if [ "$rc" -ne 0 ]; then
    echo "❌ $name failed (exit $rc)"
    exit 1
  fi
}

echo "🔍 vibe-check: lint-staged + tsc + tests"
npx lint-staged > logs/pre-commit.log 2>&1
rc=$?
cat logs/pre-commit.log
if [ "$rc" -ne 0 ]; then echo "❌ lint-staged failed — piping to agent"; exit 1; fi

run_gate "typecheck frontend" frontend/node_modules/.bin/tsc --noEmit --project frontend/tsconfig.app.json
run_gate "typecheck marketing" marketing/node_modules/.bin/tsc --noEmit --project marketing/tsconfig.json
run_gate "pytest quick" python3 -m pytest backend/tests -q --tb=line

echo "✅ pre-commit passed"